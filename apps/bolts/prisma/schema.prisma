generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
  runtime    = "nodejs"
}

datasource db {
  provider = "postgresql"
  url      = env("BOLTS_DATABASE_URL")
}

model Idea {
  id               String      @id @default(cuid())
  title            String      @db.VarChar(200)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  deletedAt        DateTime?
  archivedAt       DateTime?
  dueAt            DateTime    @default(now())
  snoozeCount      Int         @default(0)
  pendingDismissal Boolean     @default(false)
  entries          IdeaEntry[]

  @@index([deletedAt, archivedAt, dueAt, createdAt, id])
}

model IdeaEntry {
  id          String           @id @default(cuid())
  ideaId      String
  content     String           @db.Text
  isTodo      Boolean          @default(false)
  completedAt DateTime?
  createdAt   DateTime         @default(now())
  idea        Idea             @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  images      IdeaEntryImage[]

  @@index([ideaId, createdAt])
}

model IdeaEntryImage {
  id          String    @id @default(cuid())
  entryId     String
  position    Int
  contentType String    @db.VarChar(32)
  data        Bytes
  entry       IdeaEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@unique([entryId, position])
}
